config PROP_RF_CC14XX_TRX
	bool "TI CC14xx TRX external transceiver prop_rf backend"
	default y
	depends on DT_HAS_TI_CC14XX_PROP_RF_ENABLED
	depends on DT_HAS_TI_CC140XP_TRX_ENABLED
	depends on SPI
	depends on GPIO
	select SPI_ASYNC
	select CRC
	select RING_BUFFER
	help
	  Backend for the TI CC14xx external transceiver connected via SPI.
	  The TRX Host library and ti_cc14xx HAL are bundled directly under
	  this backend; no separate TI_CC14XX module is required.

if PROP_RF_CC14XX_TRX

config TI_CC14XX_INIT_PRIORITY
	int "TI CC14xx HAL driver init priority"
	default 80
	help
	  Initialization priority for the ti_cc14xx SPI transceiver HAL driver.
	  Must be lower than CONFIG_PROP_RF_INIT_PRIORITY.

module = TI_CC140XP
module-str = ti_cc140xp
source "subsys/logging/Kconfig.template.log_config"

endif # PROP_RF_CC14XX_TRX

